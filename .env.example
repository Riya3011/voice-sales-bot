# Groq API key: https://console.groq.com/
# Keep this key on the backend only. Never put it in client/.env.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
PORT=8787
# For local development:
CLIENT_ORIGIN=http://localhost:5173
# For deployment, set CLIENT_ORIGIN to your Vercel origin.
# Supabase credentials will be used in the persistent-storage deployment step.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
